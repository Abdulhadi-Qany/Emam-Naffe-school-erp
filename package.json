  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:adopt": "node --env-file=.env.local --experimental-strip-types scripts/db-adopt-migration.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "invalidate:perms": "tsx scripts/invalidate-permissions.ts",
    "test": "tsx --test tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
