# Environment Configuration
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ebps_erp

# NextAuth / Better Auth
BETTER_AUTH_URL=http://localhost:3000

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EBPS ERP

# School Configuration
NEXT_PUBLIC_SCHOOL_NAME=Emam Bukhari Private School
NEXT_PUBLIC_SCHOOL_NAME_DA=مکتب خصوصی امام بخاری
NEXT_PUBLIC_SCHOOL_NAME_PS=امام بخاری خصوصی مکتب

# SMS Gateway (optional)
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.sms-provider.com

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@emambukhari.edu.af

# File Storage (optional)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket
